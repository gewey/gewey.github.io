# Dark_Portal .gitignore — churn stays local, showpieces stay public.
#
# Why this works here: gitignore patterns are relative to this file's own
# folder, so everything under Dark_Portal/ is covered without touching the
# website root. Bonus: the rules travel with the vault if the junction
# ever moves again.
#
# The showpieces (Timeline.html, Delve.html, index.html, macro pages,
# chatroom) stay public — all their data is embedded at generation time;
# nothing on the site fetches the files below.

# Hourly telemetry engine internals (verbose reports, presence timestamps,
# machine details) — machine-local only.
Timeline/audit_logs/
Timeline/archive/
Timeline/data/
Timeline/run_ledger.md

# Archive churn (prior renders, superseded material).
.history/
**/.history/

# Mechanical Chicken automation internals (model-rotation engine, state, logs).
# The SCHEDULE_SSOT.md stays public (it documents the automations); the engine
# and its mutable state are local-only operational internals.
Mechanical_Chicken/model_rotation.py
Mechanical_Chicken/model_rotation.json
Mechanical_Chicken/rotation.log

# Python noise.
__pycache__/

# ---------------------------------------------------------------------------
# Added 2026-11-10 (Tandumonium) — legacy research pass.
# Rule of thumb: if an .html page of the HUD reads it, it is PUBLIC. If only an
# agent reads it, it is LOCAL and belongs below.
# Explicitly still public: index.html, character.html, legacy.html, Timeline.html,
# Delve.html, macrocosm.html, _fuhevva_evva.html, the macro pages, barrens_chat/.
# ---------------------------------------------------------------------------

# Research notes, harvest scratch, and anything an agent writes for itself.
Research/_local/
**/*.local.md
**/*.local.json
**/*.local.csv
_gewey_gui/_notes/
_gewey_gui/_data/*.local.json
_wow_tmp/

# Raw remote payloads captured while spelunking (looted JSON/HTML snapshots).
Research/_raw/

# ---------------------------------------------------------------------------
# Added 2026-11-10 02:0x (Tandumonium, third surface of the day) — after the
# eras / links / roster wings went public.
# Public by design (an .html pane reads them): eras.html, links.html,
# roster.html, gear.html, character.html, legacy.html, raidlogs.html.
# Local by design (evidence and generators, no page may point at them):
#   Research/_local/  - census builders, session notes, recovery scripts
#   _wow_tmp/         - scratch dumps
# The two patterns below widen that rule so a stray artifact cannot leak just
# because it was written outside those folders.
# ---------------------------------------------------------------------------
**/*.local.html
**/*.local.py
**/roster_census.html
*.tmp

# ---------------------------------------------------------------------------
# Added 2026-11-10 (Tandumonium, wide-scale legacy pass).
#
# New PUBLIC pages this pass added — all self-contained, all embedded at build
# time, nothing fetched at runtime:
#   _gewey_gui/roster.html   (54-toon census, generated by roster_extract.py)
#   _gewey_gui/gear.html     (armory snapshot, generated by gear_extract.py)
# Their generators are LOCAL, not public: Timeline/.gitignore is `*`, so the
# whole Timeline/ directory (hourly_audit.py, delve_extract.py,
# frontier_extract.py and these two) never ships. That is correct — the pages
# carry their own data, so the site needs the render, not the engine.
#
# Everything below is agent scratch: one-shot harvest loops, ad-hoc probes,
# intermediate dumps. None of it is read by any .html page.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Added 2026-11-10 (Tandumonium, "The Dynasty" pass).
#
# PUBLIC this pass: _gewey_gui/dynasty.html only. It is hand-built and
# self-contained - every table is baked in at build time, nothing is fetched.
#
# LOCAL this pass (the receipts for that page, never linked by any .html):
#   Research/_raw/armory_*.html  - the five Blizzard Armory captures
#   Research/_raw/armory_*.json  - the parsed profiles + reputation payload
#   Research/_local/             - already ignored above; sweep + scratch scripts
# The two explicit rules below exist because an Armory capture is a page of
# somebody else's HTML and must never ship from this vault.
# ---------------------------------------------------------------------------

Research/_raw/armory_*
**/armory_*.html
**/armory_*.json

# Blizzard Armory routes a page may CITE but never fetch at runtime.
**/_armory_*.py
**/_sweep_*.py

# ---------------------------------------------------------------------------
# Added 2026-11-10 (Tandumonium, "The Dynasty" pass) — bulk-fetch residue.
#
# A sibling surface swept Warcraft Logs in bulk and saved every response. All
# 4,707 of them are the same 230-byte Cloudflare "Human Verification" page. They
# are agent scratch: no .html page reads them, and they must never be published.
# The NEGATIVE RESULT is the finding (WCL walls automation); the files are not.
# ---------------------------------------------------------------------------
BulkMD_*/
BulkMD_*.zip


**/_harvest*.py
**/_probe*.py
**/_show*.py
**/_roster_tmp*.py
**/_nav_patch*.py
**/_tmp_*.py
**/_specs_dump*.txt

# Intermediate extraction dumps that a page does not consume.
Timeline/*_dump*.txt
Timeline/*_dump*.json

# ---------------------------------------------------------------------------
# Added 2026-11-10 (Tandumonium, "Reliquary" retail-archaeology pass).
#
# PUBLIC this pass — every one of these is read by at least one .html pane:
#   _gewey_gui/relics.html                  new wing; linked from every nav
#   _gewey_gui/Tandu-Hyjal_macros-cache.html  linked from relics.html
#   _gewey_gui/Chronicle.html               linked from every nav
#   _gewey_gui/dynasty.html                 linked from every nav
#   _gewey_gui/account_QUAZZARR_macros-cache.html   read by macrocosm.html
#   _gewey_gui/Tandumonium-Hyjal_macros-cache.html  read by macrocosm.html
#   _gewey_gui/legacy_bookmarks_macros-cache.html   read by macrocosm.html
#
# LOCAL this pass — raw copies and evidence, no page points at them:
#   macros/*_macros-cache.txt   raw cache text (the .html render is the page)
#   macros/*_macros-cache.html  duplicate of the _gewey_gui render
#   Research/_raw/retail_relics.json    parsed retail archaeology
#   Research/_local/_retail_relics.py   the extractor
#   Research/_local/_probe*.py, _probe*_out.txt   door probes
# The two macros/ patterns are narrow on purpose: macros/README.md stays public.
# ---------------------------------------------------------------------------
macros/*_macros-cache.txt
macros/*_macros-cache.html


# Addon Atlas data store (local inventory + macro drafts) - not git-tracked.
addon_atlas/

# ---------------------------------------------------------------------------
# Added 2026-11-11 (Tandumonium) - the Flipbook wing.
#
# PUBLIC: _gewey_gui/Flipbook.html. It bakes its own dataset at build time, so
# the page carries every position and event it needs; nothing is fetched at
# runtime.
#
# LOCAL: the engine (Timeline/flipbook_extract.py + flipbook_render.py) and the
# extracted dataset (Timeline/data/flipbook.json) live under Timeline/, which is
# already covered by Timeline/.gitignore = `*`.
#
# PUBLIC as well, and this line used to be wrong: the screenshot thumbnails in
# _gewey_gui/_shots/. Flipbook.html embeds each of them as a page-relative
# <img src="_shots/<shot>.jpg"> -- that is the filmstrip, the sticky photo pane
# and the photo pins on the canvas. Ignoring the folder meant the page shipped
# 61 references to files no published copy of the repo carries, so every
# photograph 404'd on the site while the local build looked perfect. The
# originals stay on Z: in Screenshots/; these 480px derivatives (~45 KB each)
# travel with the page. Rebuild with:
#   python Timeline/flipbook_extract.py && python Timeline/flipbook_render.py
# then commit the page together with any new thumbnails it references --
# tests/test_published_assets.py fails if a published page points at a file the
# repo does not carry.
# ---------------------------------------------------------------------------
